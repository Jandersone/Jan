import React, { useState } from 'react';

export default function Loja() {
  const sampleProducts = [
    {
      id: 1,
      title: 'Camisa Básica Masculina',
      price: 49.9,
      img: 'https://via.placeholder.com/400x300?text=Camisa',
      description: 'Malha 100% algodão. Disponível P, M, G.'
    },
    {
      id: 2,
      title: 'Tênis Esportivo',
      price: 189.0,
      img: 'https://via.placeholder.com/400x300?text=Tenis',
      description: 'Conforto e amortecimento para corridas.'
    },
    {
      id: 3,
      title: 'Relógio Minimal',
      price: 249.0,
      img: 'https://via.placeholder.com/400x300?text=Relogio',
      description: 'Design elegante, pulseira em couro sintético.'
    }
  ];

  const [products] = useState(sampleProducts);
  const [cart, setCart] = useState([]);
  const [selected, setSelected] = useState(null);
  const [query, setQuery] = useState('');
  const [showCart, setShowCart] = useState(false);

  function addToCart(prod) {
    setCart(prev => {
      const found = prev.find(p => p.id === prod.id);
      if (found) return prev.map(p => p.id === prod.id ? { ...p, qty: p.qty + 1 } : p);
      return [...prev, { ...prod, qty: 1 }];
    });
  }

  function removeFromCart(id) {
    setCart(prev => prev.filter(p => p.id !== id));
  }

  function changeQty(id, qty) {
    if (qty <= 0) return removeFromCart(id);
    setCart(prev => prev.map(p => p.id === id ? { ...p, qty } : p));
  }

  const subtotal = cart.reduce((s, p) => s + p.price * p.qty, 0);

  const filtered = products.filter(p => p.title.toLowerCase().includes(query.toLowerCase()));

  return (
    <div className="min-h-screen bg-gray-50 text-gray-900">
      <header className="bg-white shadow">
        <div className="container mx-auto px-4 py-4 flex items-center justify-between">
          <div className="flex items-center gap-4">
            <div className="text-2xl font-bold">Minha Loja</div>
            <nav className="hidden md:flex gap-4 text-sm text-gray-600">
              <a href="#" className="hover:underline">Home</a>
              <a href="#produtos" className="hover:underline">Produtos</a>
              <a href="#sobre" className="hover:underline">Sobre</a>
            </nav>
          </div>

          <div className="flex items-center gap-3">
            <input
              aria-label="Buscar produtos"
              value={query}
              onChange={e => setQuery(e.target.value)}
              className="hidden sm:block border rounded px-3 py-2 text-sm w-48"
              placeholder="Buscar..."
            />

            <button
              onClick={() => setShowCart(true)}
              className="relative bg-green-600 text-white px-3 py-2 rounded-md text-sm"
            >
              Carrinho
              <span className="ml-2 inline-block bg-white text-green-600 rounded-full px-2 text-xs font-semibold">{cart.reduce((a,b)=>a+b.qty,0)}</span>
            </button>
          </div>
        </div>
      </header>

      <main className="container mx-auto px-4 py-8">
        <section className="bg-gradient-to-r from-indigo-600 to-indigo-400 text-white rounded-lg p-8 mb-8 flex flex-col md:flex-row items-center gap-6">
          <div className="flex-1">
            <h1 className="text-3xl md:text-4xl font-extrabold">Bem-vindo à Minha Loja</h1>
            <p className="mt-3 text-lg">Produtos selecionados com cuidado. Frete rápido e segurança no pagamento.</p>
            <div className="mt-6 flex gap-3">
              <a href="#produtos" className="bg-white text-indigo-600 px-4 py-2 rounded font-semibold">Ver Produtos</a>
              <button onClick={() => setShowCart(true)} className="bg-indigo-800/30 px-4 py-2 rounded">Ver Carrinho</button>
            </div>
          </div>

          <div className="w-full md:w-1/2 flex justify-center">
            <img src="https://via.placeholder.com/520x320?text=Promo" alt="promo" className="rounded shadow-md" />
          </div>
        </section>

        <section id="produtos">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-2xl font-bold">Produtos</h2>
            <div className="text-sm text-gray-600">{filtered.length} resultado(s)</div>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {filtered.map(prod => (
              <article key={prod.id} className="bg-white rounded shadow p-4 flex flex-col">
                <img src={prod.img} alt={prod.title} className="h-44 w-full object-cover rounded mb-4" />
                <h3 className="font-semibold text-lg">{prod.title}</h3>
                <p className="text-sm text-gray-600 flex-1 mt-2">{prod.description}</p>
                <div className="mt-4 flex items-center justify-between">
                  <div className="text-xl font-bold">R$ {prod.price.toFixed(2).replace('.',',')}</div>
                  <div className="flex gap-2">
                    <button onClick={() => { setSelected(prod); }} className="text-sm px-3 py-2 border rounded">Detalhes</button>
                    <button onClick={() => addToCart(prod)} className="text-sm px-3 py-2 bg-green-600 text-white rounded">Adicionar</button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section id="sobre" className="mt-12 bg-white rounded shadow p-6">
          <h3 className="text-xl font-semibold">Sobre a loja</h3>
          <p className="mt-2 text-gray-700">Loja exemplo criada para demonstrar um layout de e-commerce. Integre meios de pagamento (PagSeguro, MercadoPago, Stripe) e um back-end para estoque e pedidos.</p>
        </section>
      </main>

      <footer className="bg-white border-t mt-12">
        <div className="container mx-auto px-4 py-6 text-sm text-gray-600 flex items-center justify-between">
          <div>© {new Date().getFullYear()} Minha Loja</div>
          <div className="flex gap-4">
            <a href="#" className="hover:underline">Política de Privacidade</a>
            <a href="#" className="hover:underline">Contato</a>
          </div>
        </div>
      </footer>

      {/* Product modal */}
      {selected && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4">
          <div className="bg-white rounded-lg max-w-2xl w-full p-6">
            <div className="flex gap-6">
              <img src={selected.img} alt={selected.title} className="w-1/3 object-cover rounded" />
              <div className="flex-1">
                <h4 className="text-2xl font-bold">{selected.title}</h4>
                <p className="mt-2 text-gray-700">{selected.description}</p>
                <div className="mt-4 font-bold text-xl">R$ {selected.price.toFixed(2).replace('.',',')}</div>
                <div className="mt-6 flex gap-2">
                  <button onClick={() => { addToCart(selected); setSelected(null); }} className="px-4 py-2 bg-green-600 text-white rounded">Adicionar ao Carrinho</button>
                  <button onClick={() => setSelected(null)} className="px-4 py-2 border rounded">Fechar</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Cart drawer */}
      {showCart && (
        <div className="fixed inset-0 flex justify-end">
          <div className="w-full sm:w-96 bg-white h-full shadow-lg p-4 flex flex-col">
            <div className="flex items-center justify-between">
              <h4 className="text-lg font-semibold">Seu Carrinho</h4>
              <button onClick={() => setShowCart(false)} className="text-sm px-2 py-1 border rounded">Fechar</button>
            </div>

            <div className="flex-1 mt-4 overflow-auto">
              {cart.length === 0 ? (
                <div className="text-gray-600">Seu carrinho está vazio.</div>
              ) : (
                cart.map(item => (
                  <div key={item.id} className="flex items-center gap-4 border-b py-3">
                    <img src={item.img} alt={item.title} className="w-16 h-16 object-cover rounded" />
                    <div className="flex-1">
                      <div className="font-semibold">{item.title}</div>
                      <div className="text-sm text-gray-600">R$ {item.price.toFixed(2).replace('.',',')}</div>
                      <div className="mt-2 flex items-center gap-2">
                        <button onClick={() => changeQty(item.id, item.qty - 1)} className="px-2 py-1 border rounded text-sm">-</button>
                        <div className="px-3">{item.qty}</div>
                        <button onClick={() => changeQty(item.id, item.qty + 1)} className="px-2 py-1 border rounded text-sm">+</button>
                      </div>
                    </div>
                    <div className="text-sm font-semibold">R$ {(item.price * item.qty).toFixed(2).replace('.',',')}</div>
                  </div>
                ))
              )}
            </div>

            <div className="border-t pt-4">
              <div className="flex items-center justify-between mb-4">
                <div className="text-sm text-gray-600">Subtotal</div>
                <div className="font-bold">R$ {subtotal.toFixed(2).replace('.',',')}</div>
              </div>
              <button className="w-full px-4 py-2 bg-indigo-600 text-white rounded mb-2">Finalizar Compra</button>
              <button onClick={() => { setCart([]); setShowCart(false); }} className="w-full px-4 py-2 border rounded">Limpar Carrinho</button>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}

